## Random spin
sandbox|start
spin = SpinAnimation(rate=10) |               SpinAnimation(rate=10, offset=4) |               SpinAnimation(rate=10, reverse=True)\
    |  SpinAnimation(rate=10, offset=3) |     SpinAnimation(rate=10, offset=1) |               SpinAnimation(rate=10)\
    |  SpinAnimation(rate=10, reverse=True) | SpinAnimation(rate=10, reverse=True, offset=9) | SpinAnimation(rate=10, offset=-1)\
    |  SpinAnimation(rate=10, reverse=True) | SpinAnimation(rate=10, offset=2) |               SpinAnimation(rate=10, offset=-5)\
    |  SpinAnimation(rate=10, reverse=True) | SpinAnimation(rate=10, offset=2, reverse=True) | SpinAnimation(rate=10)\
	|  SpinAnimation(rate=10, offset=1)
print spin*4
sandbox|end

