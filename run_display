#!/usr/bin/env python3
##pylint: disable=wrong-import-position

import argparse
import logging
import subprocess
import sys
import os
import time
import traceback

import pyxielib.animation_library as animationlib
from pyxielib import assembler, config, controller, program, scheduler, stockticker, usermenuprogram
from pyxielib.tap_revolution_config import TapRevolutionConfig
from pyxielib.nixie_shell import NixieShellConfig
from pyxielib.wifi_ap_controller import WiFiAPConfig

file_dir = os.path.dirname(os.path.realpath(__file__))
logger = logging.getLogger(__name__)


def make_parser():
    ## Overridable options default to None so get_args can tell "not supplied on the
    ## CLI" from an explicit value and fall back to the config file then a hardcoded
    ## default (see get_args / pyxielib.config.resolve).
    parser = argparse.ArgumentParser(description='Nixie tube controller')
    parser.add_argument('-c', '--controller', required=True, help="The type of controller <terminal,raspi,serial>")
    parser.add_argument('-p', '--print-code', action='store_true', help="Print the code to the output")
    parser.add_argument('-s', '--serial', help="The serial device path. Overrides --controller")
    parser.add_argument('-v', '--verbose', action='store_true', help="Be verbose in output")
    parser.add_argument('--config', help="Path to a YAML config file (CLI args override it)")
    parser.add_argument('--keyboard-event-file', help="The /dev/input/event file that represents keyboard input")
    parser.add_argument('--animations-dir', help="Directory of animations files")
    parser.add_argument('--levels-dir', help="Directory of Tap Revolution level files")
    ## default=None so "not supplied" is distinguishable from an explicit value,
    ## allowing the config file to be overridden in either direction.
    parser.add_argument('--extended-hours', action=argparse.BooleanOptionalAction, default=None,
        help="Show (or --no-extended-hours: hide) pre/after-market stock data")
    parser.add_argument('--git-check', type=int, metavar='MINUTES',
        help="Check git for updates every MINUTES minutes and exit when behind origin")
    parser.add_argument('--git-origin', metavar='REF',
        help="Git ref to compare HEAD against for --git-check (default: the configured upstream)")
    parser.add_argument('--logfile', help="Write logs to this file instead of stdout")
    parser.add_argument('--log-tail', type=int, default=None,
        help="Lines tailed by the Logs menu viewer (default: 200)")
    parser.add_argument('--loglevel',
        choices=['trace', 'debug', 'info', 'warning', 'error', 'critical'],
        help="Set the log level (default: info)")
    return parser


def get_args():
    args = make_parser().parse_args()
    cfg = config.load_config(args.config)
    args.config_data = cfg

    ## Resolve config-overridable options: CLI value > config file > hardcoded default.
    args.serial              = config.resolve(args.serial, cfg, 'serial')
    args.keyboard_event_file = config.resolve(args.keyboard_event_file, cfg, 'keyboard_event_file')
    args.animations_dir      = config.resolve(args.animations_dir, cfg, 'animations_dir', os.path.join(file_dir, 'animations'))
    args.levels_dir          = config.resolve(args.levels_dir, cfg, 'levels_dir', os.path.join(file_dir, 'levels'))
    args.extended_hours      = bool(config.resolve(args.extended_hours, cfg, 'extended_hours', False))
    args.git_check           = config.resolve(args.git_check, cfg, 'git_check')
    args.git_origin          = config.resolve(args.git_origin, cfg, 'git_origin', '@{u}')
    args.logfile             = config.resolve(args.logfile, cfg, 'logfile')
    args.log_tail            = config.resolve(args.log_tail, cfg, 'log_tail', 200)
    args.loglevel            = config.resolve(args.loglevel, cfg, 'loglevel', 'info')

    ## Fix controller argument
    if args.serial is not None:
        args.controller = 'serial'
    else:
        args.controller = args.controller.lower()

    return args


def make_tap_config(cfg):
    """Build the Tap Revolution config from the master config's path references.

    Falls back to the project-relative defaults/persistent paths when no master
    config is present (or when it omits tap_revolution paths), so settings
    persist to disk even without a --config flag.
    """
    section = cfg.get('tap_revolution') or {}
    defaults  = section.get('defaults_file')  or os.path.join(file_dir, 'config', 'tap_revolution.defaults.yaml')
    persistent = section.get('persistent_file') or os.path.join(file_dir, 'config', 'tap_revolution.yaml')
    return TapRevolutionConfig(defaults, persistent)


def make_audio_config(cfg):
    section = cfg.get('audio') or {}
    return section.get('test_sound', 'audio-test-signal')


def make_nixie_shell_config(cfg):
    """Build the Nixie Shell config from the master config's nixie_shell section."""
    return NixieShellConfig.from_dict(cfg.get('nixie_shell'))


def make_wifi_ap_config(cfg):
    """Build the WiFi AP config from the master config's wifi_ap section."""
    return WiFiAPConfig.from_dict(cfg.get('wifi_ap'))


def setup_logging(logfile=None, loglevel='info'):
    level = logging.getLevelName(loglevel.upper())
    handler = logging.FileHandler(logfile) if logfile else logging.StreamHandler(sys.stdout)
    logging.basicConfig(level=level, handlers=[handler],
        format='%(asctime)s %(levelname)-8s %(name)s: %(message)s')


def create_controller(c_type, serial, print_code, verbose, raspi_speed=10**6):
    """Create c_type"""
    ctrl = None
    if c_type == 'terminal':
        ctrl = controller.TerminalController(clear_screen=True, print_code=print_code, verbose=verbose)
    elif c_type == 'raspi':
        logger.info("Using the RaspberryPi outputs directly")
        ctrl = controller.RaspberryPiController(speed=raspi_speed, debug=verbose, print_code=print_code)
    elif c_type == 'serial':
        logger.info("Opening connection to Nixie Control Board")
        ctrl = controller.SerialController(serial, debug=verbose)
        logger.info("Connection established")
    else:
        logger.error(f"Unsupported controller type: {c_type}")

    return ctrl


GIT_FETCH_TIMEOUT = 30


def git_behind_origin(ref):
    """Fetch and return True if local HEAD is behind ref on origin.

    The fetch is bounded by a timeout: this runs on the main loop, so on the Pi
    a flaky-network `git fetch` that hangs would otherwise wedge the loop and
    silently stop the periodic check from ever firing again (while the menu's
    own timed fetch keeps working — hence "the menu shows behind but it never
    restarts"). Each outcome is logged so the check is diagnosable from nixie.log.
    """
    try:
        subprocess.run(['git', 'fetch'], cwd=file_dir, check=True,
            capture_output=True, timeout=GIT_FETCH_TIMEOUT)
        result = subprocess.run(['git', 'rev-list', '--count', f'HEAD..{ref}'],
            cwd=file_dir, check=True, capture_output=True, text=True, timeout=GIT_FETCH_TIMEOUT)
    except subprocess.TimeoutExpired:
        logger.warning(f"Git check timed out after {GIT_FETCH_TIMEOUT}s; retrying next interval")
        return False
    except subprocess.CalledProcessError as e:
        logger.error(f"Git check failed: {e.stderr.strip() if e.stderr else e}")
        return False

    behind = int(result.stdout.strip())
    logger.debug(f"Git check: HEAD is {behind} commit(s) behind {ref}")
    return behind > 0


def display_message(ctrl, message):
    """Render a static text message directly to the controller"""
    ani = animationlib.makeTextAnimation(message)
    ani.updateFrameSet()
    ctrl.send(ani.getCode())


def main(args):
    cfg = getattr(args, 'config_data', {}) or {}
    raspi_speed = (cfg.get('controller') or {}).get('raspi_speed', 10**6)
    ctrl = create_controller(args.controller, args.serial, args.print_code, args.verbose, raspi_speed)
    if ctrl is None:
        return 1

    clock_prgm = program.ClockProgram(flash=True, underscore=True)
    nyt_prgm = program.RssProgram("https://rss.nytimes.com/services/xml/rss/nyt/US.xml", size=16)
    weather_prgm = program.WeatherProgram(nws_code="KBOS")
    sleep_prgm = program.SleepProgram(ctrl)
    wake_prgm = program.WakeProgram(ctrl)
    ticker_prgm = stockticker.StockTicker(extended_hours=args.extended_hours)
    ticker_prgm.run()
    user_prgm = None
    program_map = {
        'New York Times': nyt_prgm,
        'Stock Ticker':   ticker_prgm,
        'Weather':        weather_prgm,
    }
    if args.controller == 'terminal' or args.keyboard_event_file is not None:
        user_prgm = usermenuprogram.UserMenuProgram(
            args.keyboard_event_file,
            ani_path=args.animations_dir,
            levels_path=args.levels_dir,
            tap_config=make_tap_config(cfg),
            nixie_shell_config=make_nixie_shell_config(cfg),
            wifi_ap_config=make_wifi_ap_config(cfg),
            controller=ctrl,
            program_map=program_map,
            test_sound=make_audio_config(cfg),
            logfile=args.logfile,
            log_tail=args.log_tail,
        )

    # m h dom mon dow
    schl = (
        ("*/5   * * * *", 10, ticker_prgm),
        ("*/10  * * * *", 20, clock_prgm),
        #("*/20  * * * *", 40, nyt_prgm),
        ("*/15  * * * *", 30, weather_prgm),
        ("58    8 * * *", 99, wake_prgm),
        ("0    17 * * *", 98, sleep_prgm),
    )

    periods = config.polling_periods(cfg)
    asmlr = assembler.Assembler(controller=ctrl, poll_interval=periods['assembler_poll_interval'])
    schdlr = scheduler.CronScheduler(schl, asmlr, default=clock_prgm, user_menu=user_prgm,
        period=periods['scheduler_period'], active_period=periods['scheduler_active_period'])

    logger.info("Starting program")
    schdlr.run()
    asmlr.start()
    time.sleep(1)

    error = False
    git_update = False
    git_period_secs = args.git_check * 60 if args.git_check else None
    if git_period_secs:
        logger.info(f"Git update check enabled: every {args.git_check} min against {args.git_origin}")
    else:
        logger.info("Git update check disabled")
    last_git_check = time.monotonic()
    try:
        while True:
            if not asmlr.isRunning():
                logger.error("Assembler stopped unexpectedly")
                break
            if not schdlr.isRunning():
                logger.error("Scheduler stopped unexpectedly")
                break
            if git_period_secs is not None and time.monotonic() - last_git_check >= git_period_secs:
                last_git_check = time.monotonic()
                if git_behind_origin(args.git_origin):
                    logger.info("Git update available; waiting for user menu to close")
                    git_update = True
            if git_update and (user_prgm is None or not user_prgm.active):
                logger.info("Git update: exiting for restart")
                break
            time.sleep(0.1)
    except Exception as e:
        logger.error(f"Unhandled error: {e}")
        traceback.print_exc()
        error = True
    except KeyboardInterrupt:
        logger.info("User requested exit")

    if git_update:
        asmlr.stop()
        display_message(ctrl, "GIT UPDATE")
        time.sleep(3)

    things_to_stop = [ticker_prgm, asmlr, schdlr]
    if user_prgm is not None:
        things_to_stop.append(user_prgm)

    for thing in things_to_stop:
        try:
            thing.stop()
        except Exception as e:
            logger.error(f"Failed to stop {thing}: {e}")
            traceback.print_exc()
            error = True

    if error:
        return 1

    return 0

if __name__ == '__main__':
    args = get_args()
    setup_logging(args.logfile, args.loglevel)
    sys.exit(main(args))
