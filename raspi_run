#!/bin/bash
NIXIE_DIR=$HOME/Nixie-Display
nixie_print() { "$NIXIE_DIR/send_text" --debug -c raspi --keyboard-event-file /dev/input/event0 "$@"; }

## Audio control (the Audio menu: pactl sink list/select/mute, paplay test) needs
## the user's PipeWire/PulseAudio session. When raspi_run starts outside a login
## session (e.g. @reboot cron / rc.local), XDG_RUNTIME_DIR and the session D-Bus
## aren't set, so pactl gets "Connection refused" and the sink list is empty.
## Point them at the per-user runtime dir. This requires the user manager to be
## running at boot — enable it once with: sudo loginctl enable-linger "$USER"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

cd "$NIXIE_DIR"
#nixie_print "$(ip route get 8.8.8.8 | head -1 | cut -d' ' -f7)" && sleep 10
nixie_print "Pulling from Git"
git checkout nixie-live
BEFORE_HASH=$(git rev-parse HEAD)
git pull -f || echo "Failed to pull latest code from git"
AFTER_HASH=$(git rev-parse HEAD)

PIP_FLAG=/tmp/nixie_pip_done
if [[ ! -f $PIP_FLAG ]] || [[ "$BEFORE_HASH" != "$AFTER_HASH" ]]; then
    "$NIXIE_DIR/bin/pip_nixie" -c raspi --keyboard-event-file /dev/input/event0 -- \
        pip install --break-system-packages -r "$HOME/Nixie-Display/requirements.txt" || \
    "$NIXIE_DIR/bin/pip_nixie" -c raspi --keyboard-event-file /dev/input/event0 -- \
        pip install -r "$HOME/Nixie-Display/requirements.txt"
    touch $PIP_FLAG
fi

## One-shot deployment scripts. Every *.sh in deployment_scripts/ is run once,
## keyed by its own content hash, with output captured to ~/logs/runonce.log
## (viewable in the Logs menu). Edit+repush a script to run it again; prefix
## names with NN- to control order. Use these for setup that needs a real
## session — e.g. `loginctl enable-linger` for audio — without a screen or SSH.
run_deploy_script() {
    local script="$1" name new_hash hash_file
    name=$(basename "$script")
    new_hash=$(sha1sum "$script" | cut -d' ' -f1)
    hash_file="$RUNONCE_STATE/$name.hash"
    [[ "$new_hash" == "$(cat "$hash_file" 2>/dev/null)" ]] && return
    nixie_print "Run once"
    {
        echo "=== $name $(date) (hash $new_hash) ==="
        bash "$script"
        echo "=== exit $? ==="
    } >> "$HOME/logs/runonce.log" 2>&1
    echo "$new_hash" > "$hash_file"
}

RUNONCE_DIR="$NIXIE_DIR/deployment_scripts"
RUNONCE_STATE="$HOME/.nixie/runonce_state"
if [[ -d "$RUNONCE_DIR" ]]; then
    mkdir -p "$RUNONCE_STATE" "$HOME/logs"
    for script in "$RUNONCE_DIR"/*.sh; do
        [[ -e "$script" ]] && run_deploy_script "$script"
    done
fi

cd "$HOME"
nixie_print "Starting..."
"$NIXIE_DIR/run_display" -c raspi --keyboard-event-file /dev/input/event0 --extended-hours --git-check 5 --logfile logs/nixie.log --loglevel debug 2>logs/nixie.stderr
if [[ $? -ne 0 ]]; then
    nixie_print "Crashed"
else
    nixie_print "Waiting..."
fi
exit 1
