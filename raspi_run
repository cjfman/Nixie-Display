#!/bin/bash
NIXIE_DIR=$HOME/Nixie-Display
RUNONCE_DIR="$NIXIE_DIR/deployment_scripts"
RUNONCE_STATE="$HOME/.nixie/runonce_state"
RUNONCE_KEYS="$HOME/.nixie/runonce_keys"   ## trusted RSA public keys; empty => permissive

nixie_print() {
    "$NIXIE_DIR/send_text" --debug -c raspi --keyboard-event-file /dev/input/event0 "$@"
}

## Pull and re-exec the freshly-pulled copy of this file. `git pull` rewrites this
## file while bash is executing it; bash resumes at a stale byte offset and silently
## skips sections. Re-execing restarts bash on the new file from the top.
## Only execs when HEAD actually changed: if nothing was pulled, git didn't touch the
## file so there is no byte-offset hazard. Passes --no-pull to the re-exec so the
## next run skips this step. May not return: exits via exec when HEAD changes.
git_pull() {
    cd "$NIXIE_DIR"
    nixie_print "Pulling from Git"
    git checkout nixie-live
    local before after
    before=$(git rev-parse HEAD)
    git pull -f || echo "Failed to pull latest code from git"
    after=$(git rev-parse HEAD)
    if [[ "$before" != "$after" ]]; then
        exec bash "$NIXIE_DIR/raspi_run" --no-pull "$@"
    fi
}

## Install Python dependencies only when requirements.txt changes. Keyed by the
## file's content hash (stored in ~/.nixie), so a normal reboot or a git pull that
## leaves requirements.txt untouched skips pip entirely; it runs only when the
## dependency list actually changes.
pip_install() {
    local req="$NIXIE_DIR/requirements.txt"
    local hash_file="$RUNONCE_STATE/requirements.txt.hash"
    local new_hash
    new_hash=$(sha1sum "$req" | cut -d' ' -f1)
    if [[ "$new_hash" == "$(cat "$hash_file" 2>/dev/null)" ]]; then
        return
    fi
    mkdir -p "$RUNONCE_STATE"
    "$NIXIE_DIR/bin/pip_nixie" -c raspi --keyboard-event-file /dev/input/event0 -- \
        pip install --break-system-packages -r "$req" || \
    "$NIXIE_DIR/bin/pip_nixie" -c raspi --keyboard-event-file /dev/input/event0 -- \
        pip install -r "$req"
    echo "$new_hash" > "$hash_file"
}

## One-shot deployment scripts. Every *.sh in deployment_scripts/ is run once,
## keyed by its own content hash, with output captured to ~/logs/runonce.log
## (viewable in the Logs menu). Edit+repush a script to run it again; prefix
## names with NN- to control order. Use these for setup that needs a real
## session — e.g. `loginctl enable-linger` for audio — without a screen or SSH.
run_deploy_script() {
    local script="$1" name new_hash hash_file
    name=$(basename "$script")
    new_hash=$(sha1sum "$script" | cut -d' ' -f1)
    hash_file="$RUNONCE_STATE/$name.hash"
    if [[ "$new_hash" == "$(cat "$hash_file" 2>/dev/null)" ]]; then
        return
    fi
    nixie_print "Run $name"
    {
        echo "=== $name $(date) (hash $new_hash) ==="
        ## Verify the RSA signature before running. Permissive until a public key
        ## is installed in $RUNONCE_KEYS, then strict (see pyxielib/runonce_sig.py).
        if "$NIXIE_DIR/bin/verify_runonce" --keys-dir "$RUNONCE_KEYS" "$script"; then
            bash "$script"
            echo "=== exit $? ==="
        else
            echo "=== skipped: signature check failed ==="
        fi
    } >> "$HOME/logs/runonce.log" 2>&1
    echo "$new_hash" > "$hash_file"
}

run_deploy_scripts() {
    if [[ ! -d "$RUNONCE_DIR" ]]; then
        return
    fi
    mkdir -p "$RUNONCE_STATE" "$HOME/logs"
    for script in "$RUNONCE_DIR"/*.sh; do
        if [[ -e "$script" ]]; then
            run_deploy_script "$script"
        fi
    done
}

launch_display() {
    cd "$HOME"
    nixie_print "Starting..."
    if "$NIXIE_DIR/run_display" -c raspi --keyboard-event-file /dev/input/event0 \
            --extended-hours --git-check 5 --logfile logs/nixie.log --loglevel debug \
            2>logs/nixie.stderr; then
        nixie_print "Waiting..."
    else
        nixie_print "Crashed"
    fi
}

## Audio control needs the user's PulseAudio session. When raspi_run starts
## outside a login session (@reboot cron / rc.local), XDG_RUNTIME_DIR and the
## session D-Bus aren't set, so pactl gets "Connection refused" and the Audio
## menu's sink list is empty. Enable the user manager once with:
##   sudo loginctl enable-linger "$USER"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

## Capture output to a known file so boot problems are diagnosable from the menu
## (Logs > raspi_run) rather than the daemon's unknown journal. send_text and
## run_display talk to the display directly (not via stdout), so the redirect is safe.
mkdir -p "$HOME/logs"
exec >> "$HOME/logs/raspi_run.log" 2>&1

## Parse arguments without assuming position.
NO_PULL=
ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--no-pull" ]]; then
        NO_PULL=1
    else
        ARGS+=("$arg")
    fi
done
echo "=== raspi_run $(date) (pulled=${NO_PULL:-0}) ==="

if [[ -z "$NO_PULL" ]]; then
    git_pull "${ARGS[@]}"
fi

pip_install
run_deploy_scripts
launch_display
exit 1
