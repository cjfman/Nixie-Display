#!/usr/bin/env python3
"""Sign a run-once script with an RSA private key (dev-side tool).

Writes a nixie-runonce header block (version, signer, base64 RSA-SHA256
signature) into the script. The Pi verifies it with bin/verify_runonce.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from pyxielib import runonce_sig

_EPILOG = """\
Generate a keypair once, then keep the private key secret:
  openssl genrsa -out runonce_priv.pem 4096
  openssl rsa -in runonce_priv.pem -pubout -out charles-laptop.pem

Upload only the public key to the Pi's ~/.nixie/runonce_keys/. Its filename
stem (here 'charles-laptop') is the name logged on a successful verify.
"""


def make_parser():
    parser = argparse.ArgumentParser(
        description="Sign a run-once script with an RSA private key.",
        epilog=_EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('script', help="Path to the script to sign (in place by default)")
    parser.add_argument('--key', required=True, help="Path to the RSA private key PEM")
    parser.add_argument('--name', required=True, help="Signer name to record in the header")
    parser.add_argument('-o', '--output', help="Write the signed script here instead of in place")
    return parser


def main():
    args = make_parser().parse_args()
    try:
        runonce_sig.sign(args.script, args.key, args.name, out_path=args.output)
    except Exception as e:
        print(f"sign failed: {e}", file=sys.stderr)
        sys.exit(1)
    print(f"Signed {args.output or args.script} as '{args.name}'")


if __name__ == '__main__':
    main()
