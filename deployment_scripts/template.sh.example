#!/bin/bash
# Template for a one-shot deployment script.
#
# Copy this into deployment_scripts/ as <name>.sh (e.g. enable-audio.sh) and push
# to the nixie-live branch. On the next start, raspi_run runs every *.sh in
# deployment_scripts/ exactly ONCE — keyed by each file's content hash, in
# filename order — and appends output to ~/logs/runonce.log (menu: Logs > runonce).
# Editing and re-pushing a script runs it again. Prefix names with NN- to order
# them. The .example suffix keeps this template from being run.
#
# stdout/stderr are already redirected into the log by raspi_run, so just run
# commands normally.

echo "user: $(id)"

# --- Make the audio (PipeWire/PulseAudio) session available at boot ---
# enable-linger starts the user systemd manager (and PipeWire) without a login,
# which is what makes pactl reachable from the nixie service. Try the sudo form
# first (the service has passwordless sudo for Reboot/Shutdown/WiFi); if sudo is
# scoped to only those commands, fall back to the unprivileged form, which works
# on polkit setups that allow self-linger.
if sudo -n loginctl enable-linger "$USER"; then
    echo "enable-linger: ok (sudo)"
elif loginctl enable-linger "$USER"; then
    echo "enable-linger: ok (no sudo)"
else
    echo "enable-linger: FAILED both ways (need root or a polkit self-linger rule)"
fi

# --- Diagnostics (these reflect THIS script's environment) ---
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
ls -la "$XDG_RUNTIME_DIR" 2>&1 | head

echo "--- systemctl --user (is pipewire installed/enabled?) ---"
systemctl --user is-active pipewire pipewire-pulse wireplumber 2>&1

echo "--- pactl info ---"
pactl info 2>&1

echo "--- pactl list sinks short ---"
pactl list sinks short 2>&1

# Note: right after enable-linger, PipeWire may not be up yet, so the pactl
# lines above can still fail in THIS run. Reboot (or restart the nixie service)
# and check Logs > runonce / Audio Settings > Audio Diag afterwards.
